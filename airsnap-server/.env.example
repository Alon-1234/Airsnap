# Local dev: copy to .env and edit. On Render, set these in the dashboard.
PORT=4000

# Comma-separated list of admin emails — only these can create/delete hives.
ADMIN_EMAILS=akonk13579@gmail.com

# Firebase project ID (used to verify ID tokens). No service-account JSON needed
# for ID-token verification — the Admin SDK fetches Google's public keys.
FIREBASE_PROJECT_ID=airsnap-7844f
